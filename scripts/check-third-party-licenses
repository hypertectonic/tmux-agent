#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
expected="$root/THIRD_PARTY_LICENSES.html"

generated=$(mktemp "${TMPDIR:-/tmp}/tmux-agent-licenses.XXXXXX")
cleanup() {
    rm -f -- "$generated"
}
trap cleanup EXIT HUP INT TERM

"$root/scripts/generate-third-party-licenses" "$generated" >/dev/null
if [ ! -f "$expected" ] || ! cmp -s "$generated" "$expected"; then
    printf '%s\n' \
        'THIRD_PARTY_LICENSES.html is missing or stale; run scripts/generate-third-party-licenses' >&2
    exit 1
fi
printf '%s\n' 'third-party license report is current'
