#!/bin/sh
set -eu

if [ "$#" -ne 3 ]; then
    printf 'usage: %s <rust-target> <binary> <output-directory>\n' "$0" >&2
    exit 2
fi

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
target=$1
binary=$2
output_dir=$3
case "$target" in
    aarch64-apple-darwin | x86_64-apple-darwin | \
        aarch64-unknown-linux-gnu | x86_64-unknown-linux-gnu)
        ;;
    *)
        printf 'unsupported release target: %s\n' "$target" >&2
        exit 1
        ;;
esac
version=$("$root/scripts/check-version")
asset="tmux-agent-v${version}-${target}.tar.gz"

[ -x "$binary" ] || {
    printf 'release binary is not executable: %s\n' "$binary" >&2
    exit 1
}
reported_version=$("$binary" --version)
expected_version="tmux-agent $version"
[ "$reported_version" = "$expected_version" ] || {
    printf 'release binary version mismatch: expected %s, got %s\n' \
        "$expected_version" "$reported_version" >&2
    exit 1
}
for required in README.md LICENSE THIRD_PARTY_NOTICES.md \
    THIRD_PARTY_LICENSES.html COMPATIBILITY; do
    [ -s "$root/$required" ] || {
        printf 'release input is missing or empty: %s\n' "$root/$required" >&2
        exit 1
    }
done

package_dir=$(mktemp -d "${TMPDIR:-/tmp}/tmux-agent-package.XXXXXX")
cleanup() {
    rm -rf -- "$package_dir"
}
trap cleanup EXIT HUP INT TERM

cp "$binary" "$package_dir/tmux-agent"
cp "$root/README.md" "$root/LICENSE" "$root/THIRD_PARTY_NOTICES.md" \
    "$root/THIRD_PARTY_LICENSES.html" "$package_dir/"
launcher_protocol=$(awk -F= '
    /^launcher_protocol=[1-9][0-9]*$/ { if (found) exit 1; found = 1; print $2 }
    END { if (!found) exit 1 }
' "$root/COMPATIBILITY") || {
    printf '%s\n' 'release compatibility contract is invalid' >&2
    exit 1
}
{
    printf 'launcher_protocol=%s\n' "$launcher_protocol"
    printf 'binary_version=%s\n' "$version"
    printf '%s\n' 'management_protocol=1'
} >"$package_dir/COMPATIBILITY"
printf '%s\n' "$target" >"$package_dir/TARGET"
chmod 755 "$package_dir/tmux-agent"
chmod 644 "$package_dir/README.md" "$package_dir/LICENSE" \
    "$package_dir/THIRD_PARTY_NOTICES.md" \
    "$package_dir/THIRD_PARTY_LICENSES.html" "$package_dir/COMPATIBILITY" \
    "$package_dir/TARGET"
mkdir -p "$output_dir"
tar -czf "$output_dir/$asset" -C "$package_dir" \
    tmux-agent README.md LICENSE THIRD_PARTY_NOTICES.md \
    THIRD_PARTY_LICENSES.html COMPATIBILITY TARGET
printf '%s\n' "$output_dir/$asset"
