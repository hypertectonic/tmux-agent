#!/bin/sh
set -eu

TMUX_AGENT_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
export TMUX_AGENT_ROOT
. "$TMUX_AGENT_ROOT/scripts/lib.sh"

restart_daemon=1
case "${1:-}" in
    '')
        ;;
    --no-restart)
        restart_daemon=0
        ;;
    *)
        printf 'usage: %s [--no-restart]\n' "$0" >&2
        exit 2
        ;;
esac

data_dir=$(tmux_agent_data_dir)
state_dir=$(tmux_agent_state_dir)
versions_dir="$data_dir/versions"
version=$(tmux_agent_version)
destination_dir="$versions_dir/$version"
destination_binary="$destination_dir/tmux-agent"
temporary_dir=
staging_dir=
lock_owned=0
install_complete=0
migration_same_version=0

cleanup() {
    exit_status=$?
    if [ -n "$temporary_dir" ] && [ -d "$temporary_dir" ]; then
        rm -rf -- "$temporary_dir"
    fi
    if [ -n "$staging_dir" ] && [ -d "$staging_dir" ]; then
        case "$staging_dir" in
            "$versions_dir"/.staging-*) rm -rf -- "$staging_dir" ;;
        esac
    fi
    if [ "$lock_owned" -eq 1 ]; then
        tmux_agent_install_lock_release 2>/dev/null || true
    fi
    if [ "$exit_status" -ne 0 ] && [ "$install_complete" -eq 0 ]; then
        current_status=$(tmux_agent_read_status 2>/dev/null || true)
        case "$current_status" in
            FAILED\|* | UNSUPPORTED\|*)
                ;;
            *)
                tmux_agent_write_status \
                    "FAILED|installation was interrupted; inspect $(tmux_agent_install_log)"
                ;;
        esac
    fi
    return "$exit_status"
}
trap cleanup EXIT HUP INT TERM

if [ -e "$data_dir" ] || [ -L "$data_dir" ]; then
    if [ ! -d "$data_dir" ] || [ -L "$data_dir" ]; then
        printf 'tmux-agent: managed data path is not a real directory: %s\n' \
            "$data_dir" >&2
        exit 1
    fi
else
    mkdir -p "$data_dir"
fi
if [ -e "$versions_dir" ] || [ -L "$versions_dir" ]; then
    if [ ! -d "$versions_dir" ] || [ -L "$versions_dir" ]; then
        tmux_agent_write_status "FAILED|managed version store is not a real directory"
        exit 1
    fi
else
    if ! mkdir "$versions_dir" 2>/dev/null &&
        { [ ! -d "$versions_dir" ] || [ -L "$versions_dir" ]; }; then
        tmux_agent_write_status "FAILED|managed version store could not be created safely"
        exit 1
    fi
fi
mkdir -p "$state_dir"
chmod 700 "$data_dir" "$versions_dir" "$state_dir"
: >"$data_dir/.tmux-agent-managed"
chmod 600 "$data_dir/.tmux-agent-managed"

if ! tmux_agent_install_lock_acquire; then
    tmux_agent_write_status "FAILED|another installation did not finish within 30 seconds"
    exit 1
fi
lock_owned=1

old_current=$(readlink "$data_dir/current" 2>/dev/null || true)
preserve_current=0
if [ -n "${TMUX_AGENT_MIGRATE_BINARY:-}" ]; then
    migration_binary=$TMUX_AGENT_MIGRATE_BINARY
    if [ -L "$migration_binary" ] || [ ! -f "$migration_binary" ] ||
        [ ! -x "$migration_binary" ]; then
        tmux_agent_write_status "FAILED|standalone migration source is not a regular executable"
        exit 1
    fi
    migration_version=$(tmux_agent_binary_version "$migration_binary") || {
        tmux_agent_write_status "FAILED|standalone migration source has an invalid version"
        exit 1
    }
    migration_target=$(tmux_agent_target) || {
        tmux_agent_write_status "FAILED|standalone migration platform is unsupported"
        exit 1
    }
    migration_dir="$versions_dir/$migration_version"
    migration_destination="$migration_dir/tmux-agent"
    if [ "$migration_version" = "$version" ]; then
        migration_same_version=1
    elif [ -e "$migration_dir" ] || [ -L "$migration_dir" ]; then
        migration_contract=$(tmux_agent_compatibility_contract) || {
            tmux_agent_write_status "FAILED|checkout compatibility contract is invalid"
            exit 1
        }
        migration_protocol=${migration_contract%%|*}
        if [ ! -d "$migration_dir" ] || [ -L "$migration_dir" ] ||
            [ ! -f "$migration_destination" ] || [ -L "$migration_destination" ] ||
            [ ! -f "$migration_dir/COMPATIBILITY" ] ||
            [ -L "$migration_dir/COMPATIBILITY" ] ||
            [ ! -f "$migration_dir/TARGET" ] || [ -L "$migration_dir/TARGET" ]; then
            tmux_agent_write_status \
                "FAILED|existing migration target is not a real in-store version: $migration_dir"
            exit 1
        fi
        migration_metadata=$(tmux_agent_version_compatibility "$migration_dir" || true)
        migration_recorded_target=
        IFS= read -r migration_recorded_target <"$migration_dir/TARGET" || true
        if ! tmux_agent_binary_matches "$migration_destination" "$migration_version" ||
            ! cmp -s "$migration_binary" "$migration_destination" ||
            [ "${migration_metadata%%|*}" != "$migration_protocol" ] ||
            [ "${migration_metadata#*|}" != "$migration_version" ] ||
            [ "$migration_recorded_target" != "$migration_target" ]; then
            tmux_agent_write_status \
                "FAILED|existing migration target is invalid: $migration_dir"
            exit 1
        fi
    else
        staging_dir="$versions_dir/.staging-migration-${migration_version}-$$"
        mkdir "$staging_dir"
        chmod 700 "$staging_dir"
        cp "$migration_binary" "$staging_dir/tmux-agent"
        chmod 755 "$staging_dir/tmux-agent"
        tmux_agent_write_version_compatibility "$staging_dir" "$migration_version"
        printf '%s\n' "$migration_target" >"$staging_dir/TARGET"
        chmod 600 "$staging_dir/TARGET"
        if ! tmux_agent_binary_matches "$staging_dir/tmux-agent" "$migration_version"; then
            tmux_agent_write_status "FAILED|copied migration binary changed during staging"
            exit 1
        fi
        mv "$staging_dir" "$migration_dir"
        staging_dir=
    fi
    if [ "$migration_same_version" -eq 0 ] && [ -z "$old_current" ]; then
        tmux_agent_activate_version "$migration_version"
        old_current=$(readlink "$data_dir/current" 2>/dev/null || true)
    fi
fi
manager_available=0
manager_version=
if manager_binary=$(tmux_agent_manager_binary 2>/dev/null); then
    manager_available=1
    manager_version=$(tmux_agent_binary_version "$manager_binary") || {
        tmux_agent_write_status "FAILED|managed lifecycle controller version is invalid"
        exit 1
    }
elif [ -e "$data_dir/manager" ] || [ -L "$data_dir/manager" ]; then
    tmux_agent_write_status "FAILED|managed lifecycle controller is invalid"
    exit 1
fi
if [ "$migration_same_version" -eq 0 ] && tmux_agent_current_binary_compatible; then
    current_version=$(tmux_agent_current_managed_version)
    if [ "$manager_available" -eq 1 ]; then
        tmux_agent_write_status "READY|$current_version"
        install_complete=1
        printf 'tmux-agent: compatible managed binary %s is already current\n' \
            "$current_version"
        printf 'tmux-agent: ready at %s\n' "$data_dir/current"
        exit 0
    fi
    preserve_current=1
fi

contract=$(tmux_agent_compatibility_contract) || {
    tmux_agent_write_status "FAILED|checkout compatibility contract is invalid"
    exit 1
}
minimum_version=${contract#*|}
if ! tmux_agent_version_at_least "$version" "$minimum_version"; then
    tmux_agent_write_status \
        "FAILED|checkout version $version is below compatibility floor $minimum_version"
    exit 1
fi
system_name=${TMUX_AGENT_UNAME_S:-$(uname -s)}
machine_name=${TMUX_AGENT_UNAME_M:-$(uname -m)}
target=$(tmux_agent_target) || {
    tmux_agent_write_status "UNSUPPORTED|$system_name/$machine_name"
    exit 1
}
archive_name="tmux-agent-v${version}-${target}.tar.gz"

if [ "$migration_same_version" -eq 0 ] &&
    tmux_agent_managed_version_management_capable "$version"; then
    tmux_agent_write_version_compatibility "$destination_dir" "$version" 1
else
    tmux_agent_write_status "INSTALLING|$version"
    release_base=$(tmux_agent_release_base_url) || {
        tmux_agent_write_status "FAILED|release URL is not configured"
        exit 1
    }
    temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/tmux-agent-install.XXXXXX")
    chmod 700 "$temporary_dir"
    archive_path="$temporary_dir/$archive_name"
    sums_path="$temporary_dir/SHA256SUMS"
    release_url="${release_base}/v${version}"

    printf 'tmux-agent: downloading %s\n' "$archive_name"
    if ! tmux_agent_download "$release_url/$archive_name" "$archive_path"; then
        tmux_agent_write_status "FAILED|could not download $archive_name"
        exit 1
    fi
    if ! tmux_agent_download "$release_url/SHA256SUMS" "$sums_path"; then
        tmux_agent_write_status "FAILED|could not download SHA256SUMS"
        exit 1
    fi
    expected_checksum=$(awk -v name="$archive_name" '$2 == name || $2 == "*" name { print $1; exit }' "$sums_path")
    if [ "${#expected_checksum}" -ne 64 ] ||
        printf '%s\n' "$expected_checksum" | grep -q '[^0-9a-fA-F]'; then
        tmux_agent_write_status "FAILED|SHA256SUMS has no valid entry for $archive_name"
        exit 1
    fi
    actual_checksum=$(tmux_agent_sha256 "$archive_path") || {
        tmux_agent_write_status "FAILED|no checksum tool is available"
        exit 1
    }
    if [ "$actual_checksum" != "$expected_checksum" ]; then
        tmux_agent_write_status "FAILED|checksum mismatch for $archive_name"
        printf '%s\n' "tmux-agent: checksum mismatch for $archive_name" >&2
        exit 1
    fi

    archive_entries=$(tar -tzf "$archive_path") || {
        tmux_agent_write_status "FAILED|release archive is unreadable"
        exit 1
    }
    archive_details=$(tar -tvzf "$archive_path") || {
        tmux_agent_write_status "FAILED|release archive metadata is unreadable"
        exit 1
    }
    if printf '%s\n' "$archive_details" |
        awk '$1 !~ /^-/ { invalid = 1 } END { exit invalid ? 0 : 1 }'; then
        tmux_agent_write_status "FAILED|release archive contains a non-regular entry"
        exit 1
    fi
    invalid_entry=0
    for archive_entry in $archive_entries; do
        normalized_entry=${archive_entry#./}
        case "$normalized_entry" in
            tmux-agent | README.md | LICENSE | THIRD_PARTY_NOTICES.md | \
                THIRD_PARTY_LICENSES.html | COMPATIBILITY | TARGET)
                ;;
            *)
                invalid_entry=1
                ;;
        esac
    done
    if [ "$invalid_entry" -ne 0 ]; then
        tmux_agent_write_status "FAILED|release archive contains an unexpected path"
        exit 1
    fi
    for required_entry in tmux-agent README.md LICENSE THIRD_PARTY_NOTICES.md \
        THIRD_PARTY_LICENSES.html COMPATIBILITY TARGET; do
        if ! printf '%s\n' "$archive_entries" | grep -qxE "(\\./)?${required_entry}"; then
            tmux_agent_write_status "FAILED|release archive is missing $required_entry"
            exit 1
        fi
    done

    staging_dir="$versions_dir/.staging-${version}-$$"
    mkdir "$staging_dir"
    chmod 700 "$staging_dir"
    if ! tar -xzf "$archive_path" -C "$staging_dir"; then
        tmux_agent_write_status "FAILED|release archive extraction failed"
        exit 1
    fi
    for required_entry in tmux-agent README.md LICENSE THIRD_PARTY_NOTICES.md \
        THIRD_PARTY_LICENSES.html COMPATIBILITY TARGET; do
        if [ -L "$staging_dir/$required_entry" ] ||
            [ ! -f "$staging_dir/$required_entry" ]; then
            tmux_agent_write_status \
                "FAILED|release archive has no regular $required_entry file"
            exit 1
        fi
    done
    chmod 755 "$staging_dir/tmux-agent"
    if ! tmux_agent_binary_matches "$staging_dir/tmux-agent" "$version"; then
        tmux_agent_write_status "FAILED|downloaded binary reports the wrong version"
        exit 1
    fi
    chmod 644 "$staging_dir/README.md" "$staging_dir/LICENSE" \
        "$staging_dir/THIRD_PARTY_NOTICES.md" \
        "$staging_dir/THIRD_PARTY_LICENSES.html" "$staging_dir/COMPATIBILITY" \
        "$staging_dir/TARGET"
    IFS= read -r packaged_target <"$staging_dir/TARGET" || true
    if [ "$packaged_target" != "$target" ]; then
        tmux_agent_write_status "FAILED|release archive records the wrong platform"
        exit 1
    fi
    packaged_compatibility=$(tmux_agent_version_compatibility "$staging_dir") || {
        tmux_agent_write_status "FAILED|release archive compatibility metadata is invalid"
        exit 1
    }
    packaged_protocol=${packaged_compatibility%%|*}
    packaged_version=${packaged_compatibility#*|}
    packaged_management=$(tmux_agent_version_management_protocol "$staging_dir" || true)
    required_protocol=${contract%%|*}
    if [ "$packaged_protocol" != "$required_protocol" ] ||
        [ "$packaged_version" != "$version" ] ||
        [ "$packaged_management" != 1 ]; then
        tmux_agent_write_status "FAILED|release archive compatibility metadata does not match"
        exit 1
    fi
    tmux_agent_write_version_compatibility "$staging_dir" "$version" 1

    if [ "$migration_same_version" -eq 1 ] &&
        ! cmp -s "$migration_binary" "$staging_dir/tmux-agent"; then
        tmux_agent_write_status \
            "FAILED|same-version direct binary differs from the verified release"
        exit 1
    fi

    if [ -e "$destination_dir" ] || [ -L "$destination_dir" ]; then
        if ! tmux_agent_managed_version_management_capable "$version"; then
            tmux_agent_write_status "FAILED|existing version directory is invalid: $destination_dir"
            exit 1
        fi
        if [ "$migration_same_version" -eq 1 ] &&
            ! cmp -s "$staging_dir/tmux-agent" "$destination_binary"; then
            tmux_agent_write_status \
                "FAILED|existing same-version binary differs from the verified release"
            exit 1
        fi
        rm -rf -- "$staging_dir"
        staging_dir=
    else
        mv "$staging_dir" "$destination_dir"
        staging_dir=
    fi
fi

if [ "$manager_available" -eq 0 ] ||
    ! tmux_agent_version_at_least "$manager_version" "$version"; then
    tmux_agent_activate_manager "$version"
fi
if [ "$preserve_current" -eq 0 ]; then
    tmux_agent_activate_version "$version"
fi
ready_version=$(tmux_agent_current_managed_version) || {
    tmux_agent_write_status "FAILED|managed current activation is invalid"
    exit 1
}
tmux_agent_write_status "READY|$ready_version"

new_current=$(readlink "$data_dir/current" 2>/dev/null || true)
if [ "$restart_daemon" -eq 1 ] && [ "$old_current" != "$new_current" ]; then
    "$TMUX_AGENT_ROOT/bin/tmux-agent" daemon restart >/dev/null 2>&1 || {
        "$TMUX_AGENT_ROOT/bin/tmux-agent" daemon start >/dev/null 2>&1 || true
    }
fi
install_complete=1
printf 'tmux-agent: ready at %s\n' "$data_dir/current"
